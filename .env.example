# PayMitto quote-API credentials for the serverless functions.
#
# Copy to `.env` (git-ignored) for local `netlify dev`, and set the same keys
# in the Netlify dashboard (Site settings → Environment variables) for deploys.
# NEVER commit real values. The client_secret is treated like a private key.

READYREMIT_CLIENT_ID=your-sandbox-client-id
READYREMIT_CLIENT_SECRET=your-sandbox-client-secret

# REQUIRED for live quotes. GET /quote returns SenderUndetermined for a plain
# client-level token, so the widget mints a SENDER-SCOPED token from this ID.
# For a B2C marketing widget this is the single business-as-sender ID from the
# Integrations Team. Without it, corridors + quotes are disabled and the widget
# shows illustrative rates only.
READYREMIT_SENDER_ID=your-sandbox-sender-id

# Optional overrides (sensible defaults shown):
# READYREMIT_API_BASE=https://sandbox-api.readyremit.com/v1
# READYREMIT_AUDIENCE=https://sandbox-api.readyremit.com
# READYREMIT_SRC_CURRENCY=USD
